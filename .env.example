# ===== لازم =====
TELEGRAM_BOT_TOKEN=          # من @BotFather
ANTHROPIC_API_KEY=           # من console.anthropic.com
OWNER_ID=                    # رقمك في تيليجرام (أرسل /myid للبوت)

# ===== اختياري =====
YOUTUBE_API_KEY=             # مجاني من Google Cloud (YouTube Data API v3)
TEXT_MODEL=claude-haiku-5-5  # للأسئلة النصية
SMART_MODEL=claude-sonnet-5-5 # للصور والتقارير والقلتشات
DAILY_TIME=20:00             # وقت التقرير اليومي (تقدر تغيره من البوت بـ /time)
TIMEZONE=Asia/Riyadh
GLITCH_INTERVAL_HOURS=4      # كل كم ساعة يشيك على القلتشات
MAX_SEARCHES_CHAT=3
MAX_SEARCHES_REPORT=4
HISTORY_MESSAGES=12
DB_PATH=data/bot.db          # على Railway حطه على Volume: /data/bot.db
# EXTRA_FEEDS=اسم|رابط;اسم2|رابط2
